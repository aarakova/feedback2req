{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback2req.invalid/contracts/ai/v1/extract_feedback.request.schema.json",
  "title": "extract_feedback.request",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation": {
      "const": "extract_feedback"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "https://feedback2req.invalid/contracts/ai/v1/common.schema.json#/$defs/TextSegment"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "https://feedback2req.invalid/contracts/ai/v1/common.schema.json#/$defs/DocumentExcerpt"
          },
          "minItems": 0
        },
        "previous_findings": {
          "type": "array",
          "items": {
            "$ref": "https://feedback2req.invalid/contracts/ai/v1/common.schema.json#/$defs/FindingView"
          },
          "minItems": 0
        },
        "change_reason": {
          "type": "string",
          "minLength": 1
        },
        "previous_fragments": {
          "type": "array",
          "items": {
            "$ref": "https://feedback2req.invalid/contracts/ai/v1/common.schema.json#/$defs/FragmentView"
          },
          "minItems": 0
        }
      },
      "required": [
        "segments",
        "documents"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "operation",
    "project_id",
    "request_id",
    "input"
  ],
  "additionalProperties": false
}
